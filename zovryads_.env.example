# Telegram API credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# BotFather tokens
TELEGRAM_BOT_TOKEN=
LOGGER_BOT_TOKEN=

# MongoDB connection string
MONGO_URI=
DB_NAME=adsbot_db

# Telegram user ID(s) permitted to administer the bot
ADMIN_ID=
# Optional comma-separated additional admins; ADMIN_ID is included automatically.
ADMIN_IDS=

# Required for persistent account-session encryption.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Branded bot/channel defaults
BOT_USERNAME=Zovrybot
LOGGER_BOT_USERNAME=Zovry2bot
ADMIN_USERNAME=ZovryChat
MUST_JOIN_CHANNEL_ID=@ZovryAds
MUST_JOIN_CHANNEL_URL=https://t.me/ZovryAds
MUSTJOIN_GROUP_ID=@ZovryChat
MUSTJOIN_GROUP_URL=https://t.me/ZovryChat
ENABLE_FORCE_JOIN=true
